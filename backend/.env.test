PORT=5001
NODE_ENV=test

# Database Configuration - TEST DATABASE
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=medical_qbank_test
DB_DIALECT=mysql

# JWT Secrets
JWT_SECRET=test_jwt_secret_key_for_testing
JWT_EXPIRE=15m
